<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huazaiki.mapper.UsersMapper">

    <resultMap id="BaseResultMap" type="com.huazaiki.domain.Users">
            <id property="userId" column="user_id" jdbcType="INTEGER"/>
            <result property="userName" column="user_name" jdbcType="VARCHAR"/>
            <result property="userPwd" column="user_pwd" jdbcType="VARCHAR"/>
            <result property="userEmail" column="user_email" jdbcType="VARCHAR"/>
            <result property="userPhone" column="user_phone" jdbcType="VARCHAR"/>
            <result property="isAdmin" column="is_admin" jdbcType="INTEGER"/>
    </resultMap>

    <select id="selectByUsername" resultType="com.huazaiki.domain.Users">
        SELECT *
        from users
        where user_name = #{userName}
    </select>
</mapper>
